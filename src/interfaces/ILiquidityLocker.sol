pragma solidity ^0.8.22;

/**
 * @dev Interface for a liquidity locker. It temporarily holds liquidity positions to ensure they cannot be withdrawn and can migrate them to the Aerodrome locker (see ICLLockerFactory).
 * This interface defines the functions and events that a liquidity locker must implement.
 */
interface ILiquidityLocker {
    error LiquidityLocker__NotFeeAccount();
    error LiquidityLocker__NotLiquidityMigrator();
    error LiquidityLocker__EmptyLockedPositions();
    error LiquidityLocker__NotValidPool();

    event CollectedFees(uint256 amount0, uint256 amount1);
    event LiquidityLocked(uint256 indexed tokenId, address indexed pool);
    event LiquidityMigrated(
        uint256 indexed tokenId,
        address indexed pool,
        address indexed locker
    );

    /**
     * @notice Locks a liquidity position NFT in the locker.
     * @dev This function can only be called by the liquidity migrator.
     * @param tokenId The ID of the liquidity position NFT to lock.
     * @param pool The address of the pool associated with the liquidity position.
     */
    function lock(uint256 tokenId, address pool) external;

    /**
     * @notice Collects the fees generated by a locked liquidity position.
     * @dev This function can only be called by the fee account.
     * @param pool The address of the pool associated with the liquidity position.
     * @return amount0 The amount of token0 fees collected.
     * @return amount1 The amount of token1 fees collected.
     */
    function collectFees(
        address pool
    ) external returns (uint256 amount0, uint256 amount1);

    /**
     * @notice Migrates a locked liquidity position to a Aerodrome locker.
     * @param pool The address of the pool associated with the liquidity position.
     */
    function migrateLiquidity(address pool) external;

    /**
     * @notice Sets the address of the liquidity migrator contract.
     * @dev This function can only be called by the owner of the contract.
     * @param _liquidityMigrator The address of the new liquidity migrator contract.
     */
    function setLiquidityMigrator(address _liquidityMigrator) external;

    /**
     * @return Returns the total number of locked positions in the locker.
     */
    function lockedPositionsCount() external view returns (uint256);

    /**
     * @notice Returns the token ID of the locked liquidity position for a specific pool.
     * @param pool The address of the associated pool.
     * @return tokenId The ID of the locked liquidity position NFT.
     */
    function lockedPosition(
        address pool
    ) external view returns (uint256 tokenId);

    /**
     * @notice Returns the pool address at a specific index in the list of locked pools.
     * @param index The index of the pool in the list.
     */
    function poolAt(uint256 index) external view returns (address pool);

    /**
     * @return The address of the Aerodrome locker factory contract.
     */
    function AERO_LOCKER_FACTORY() external view returns (address);
}
